{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "devboard",
      "displayName": "Build (STM32-H743ZI Nucleo-144 dev board)",
      "description": "Build the firmware for STM32-H743ZI (Nucleo-144 dev board)",
      "generator": "Ninja",
      "toolchainFile": "etc/cmake/stm32_gcc.cmake",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": {
          "type": "string",
          "value": "Debug"
        },
        "TELLER_BOARD": {
          "type": "string",
          "value": "Nucleo144"
        },
        "STM32_TARGET_TRIPLET": {
          "type": "string",
          "value": "arm-none-eabi"
        }
      }
    },
    {
      "name": "default",
      "displayName": "Build (STM32-F415RG TELLER OBC board)",
      "description": "Build the firmware for STM32-F415RG (TELLER OBC board)",
      "generator": "Ninja",
      "toolchainFile": "etc/cmake/stm32_gcc.cmake",
      "binaryDir": "${sourceDir}/build/prod",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": {
          "type": "string",
          "value": "Release"
        },
        "TELLER_BOARD": {
          "type": "string",
          "value": "STM32F4"
        },
        "STM32_TARGET_TRIPLET": {
          "type": "string",
          "value": "arm-none-eabi"
        }
      }
    },
    {
      "name": "host",
      "displayName": "Build (host machine)",
      "description": "Build a firmware simulator for the host machine",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": {
          "type": "string",
          "value": "Debug"
        },
        "TELLER_BOARD": {
          "type": "string",
          "value": "POSIX"
        },
        "TELLER_ENABLE_CODE_COVERAGE": {
          "type": "BOOL",
          "value": "ON"
        },
        "USE_SANITIZER": {
          "type": "string",
          "value": "Address;Undefined"
        }
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-dev",
      "displayName": "Build firmware (STM32-H743ZI Nucleo-144)",
      "description": "Build firmware without uploading it",
      "configurePreset": "devboard",
      "targets": [
        "teller-obc"
      ]
    },
    {
      "name": "build-prod",
      "displayName": "Build firmware (STM32-F415RG TELLER OBC board)",
      "description": "Build firmware without uploading it",
      "configurePreset": "default",
      "targets": [
        "teller-obc"
      ]
    },
    {
      "name": "upload-dev",
      "displayName": "Upload firmware (STM32-H743ZI Nucleo-144)",
      "description": "Upload built firmware with openocd",
      "configurePreset": "devboard",
      "targets": [
        "upload"
      ]
    },
    {
      "name": "upload-prod",
      "displayName": "Upload firmware (STM32-F415RG TELLER OBC board)",
      "description": "Upload built firmware with openocd",
      "configurePreset": "default",
      "targets": [
        "upload"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "test",
      "displayName": "Run unit tests (host machine)",
      "description": "Run unit tests on the host machine",
      "configurePreset": "host",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    }
  ]
}
