{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Build (STM32-H743ZI Nucleo-144)",
      "description": "Build the firmware for STM32-H743ZI Nucleo-144",
      "generator": "Ninja",
      "toolchainFile": "etc/cmake/stm32_gcc.cmake",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": {
          "type": "string",
          "value": "Debug"
        },
        "TELLER_BOARD": {
          "type": "string",
          "value": "Nucleo144"
        },
        "STM32_TARGET_TRIPLET": {
          "type": "string",
          "value": "arm-none-eabi"
        }
      }
    }
  ],
  "buildPresets": [
    {
      "name": "upload",
      "displayName": "Upload firmware (STM32-H743ZI Nucleo-144)",
      "description": "Upload built firmware with openocd",
      "configurePreset": "default",
      "targets": [
        "upload"
      ]
    }
  ]
}
